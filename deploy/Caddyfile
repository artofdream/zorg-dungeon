# Caddy configuration for zorg.artof.link
{
    admin :2019
    email claude.tsarafidy@gmail.com
}

# Production domain
zorg.artof.link {
    # Observability: Grafana under /grafana/
    handle /grafana* {
        reverse_proxy grafana:3000
    }

    # Application: Web app
    handle /* {
        reverse_proxy web:80
    }
}

# Local / fallback entrypoint
:80 {
    handle /grafana* {
        reverse_proxy grafana:3000
    }

    handle /* {
        reverse_proxy web:80
    }
}
