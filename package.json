{
  "name": "zorg-dungeon",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "trace": "node scripts/check-requirements-trace.mjs",
    "ledger": "node scripts/check-honesty-ledger.mjs",
    "findings": "node scripts/check-findings-ledger.mjs",
    "docs-graph": "node scripts/check-docs-graph.mjs",
    "governance": "npm run trace && npm run ledger && npm run findings && npm run docs-graph",
    "test:e2e": "pnpm --filter @zorg/web test:e2e",
    "probe:journeys": "pnpm --filter @zorg/web probe:journeys"
  }
}
